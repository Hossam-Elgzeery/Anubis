    "commander": "^15.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "node-llama-cpp": "^3.22.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hossam-Elgzeery/Anubis.git"
  },
  "homepage": "https://github.com/Hossam-Elgzeery/Anubis#readme",
